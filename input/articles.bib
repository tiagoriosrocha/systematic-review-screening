  abstract={The subject proposed for discussion during this panel consisted in evaluating the role of digital humanities from the point of view of specific disciplinary research practices.The first analyzed discipline, involved in the digital humanities practices and theories, is Knowledge Organization (section 2); the second is Archaeological Computing (section 3).},
  doi={10.1145/2802612.2802629},
  booktitle={Proceedings of the Third AIUCD Annual Conference on Humanities and Their Methods in the Digital Ecosystem},
