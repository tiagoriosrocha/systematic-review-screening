 doi = {10.1016/j.apenergy.2025.126922},
 journal = {Applied Energy},
 keywords = {Artificial intelligence, Digital twin, Maturity hierarchy, Nuclear reactor},
 note = {Export Date: 23 February 2026; Cited By: 0 | RAYYAN-INCLUSION: {"Tiago Rios"=>"Excluded"} | RAYYAN-EXCLUSION-REASONS: Não envolve XAI},
 publisher = {Elsevier Ltd},
 title = {Shaping the future of nuclear reactors with digital twins: Current developments and perspectives},
