 author = {Bran Selić},
 doi = {10.1007/s10270-025-01348-4},
 journal = {Software and Systems Modeling},
 month = {1},
 title = {Reflections from a long career in software},
 url = {https://link.springer.com/article/10.1007/s10270-025-01348-4},
